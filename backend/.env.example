# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_coordinator
DB_USER=postgres
DB_PASSWORD=your_password_here

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Manufacturing Inventory Coordinator

# JWT Configuration
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=InventoryCoordinatorAPI
JWT_AUDIENCE=InventoryCoordinatorClient
